generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String                @id @default(cuid())
  phoneNumber          String                @unique
  role                 UserRole              @default(USER)
  createdAt            DateTime              @default(now())
  birthDate            DateTime?
  fullName             String?
  aiGenerationRequests AiGenerationRequest[]
  bookings             Booking[]
  generations          Generation[]

  @@map("users")
}

model OtpCode {
  id          String     @id @default(cuid())
  phoneNumber String
  codeHash    String
  expiresAt   DateTime
  attempts    Int        @default(0)
  createdAt   DateTime   @default(now())
  birthDate   DateTime?
  fullName    String?
  purpose     OtpPurpose @default(LOGIN)

  @@index([phoneNumber])
  @@index([phoneNumber, expiresAt])
  @@index([phoneNumber, purpose])
  @@map("otp_codes")
}

model OtpRequest {
  id          String   @id @default(cuid())
  phoneNumber String
  requestedAt DateTime @default(now())

  @@index([phoneNumber, requestedAt])
  @@map("otp_requests")
}

model Service {
  id          String    @id @default(cuid())
  name        String
  description String?
  duration    Int
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  bookings    Booking[]

  @@map("services")
}

model BlockedTime {
  id        String   @id @default(cuid())
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@index([startsAt])
  @@index([endsAt])
  @@map("blocked_times")
}

model Booking {
  id        String        @id @default(cuid())
  userId    String
  serviceId String
  status    BookingStatus @default(CONFIRMED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  endsAt    DateTime
  startsAt  DateTime
  service   Service       @relation(fields: [serviceId], references: [id])
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([serviceId])
  @@index([startsAt])
  @@index([endsAt])
  @@index([status])
  @@map("bookings")
}

model Generation {
  id               String         @id @default(cuid())
  userId           String
  originalPhotoUrl String
  resultPhotoUrl   String
  styleChosen      String?
  createdAt        DateTime       @default(now())
  workflowType     AiWorkflowType @default(CUSTOM)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, workflowType])
  @@map("generations")
}

model AiGenerationRequest {
  id          String   @id @default(cuid())
  userId      String
  requestedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, requestedAt])
  @@map("ai_generation_requests")
}

enum UserRole {
  USER
  ADMIN
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum OtpPurpose {
  LOGIN
  REGISTER
}

enum AiWorkflowType {
  CUSTOM
  RECOMMENDATION
}
