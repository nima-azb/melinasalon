generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String                @id @default(cuid())
  phoneNumber          String                @unique
  role                 UserRole              @default(USER)
  createdAt            DateTime              @default(now())
  birthDate            DateTime?
  fullName             String?
  lastBirthdaySmsYear  Int?
  aiGenerationRequests AiGenerationRequest[]
  bookings             Booking[]
  generations          Generation[]
  discountCodes        DiscountCode[]

  @@map("users")
}

model DiscountCode {
  id              String    @id @default(cuid())
  code            String    @unique
  userId          String
  discountPercent Int       @default(20)
  expiresAt       DateTime
  isUsed          Boolean   @default(false)
  usedAt          DateTime?
  createdAt       DateTime  @default(now())

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([code])
  @@map("discount_codes")
}

model OtpCode {
  id          String     @id @default(cuid())
  phoneNumber String
  codeHash    String
  expiresAt   DateTime
  attempts    Int        @default(0)
  createdAt   DateTime   @default(now())
  birthDate   DateTime?
  fullName    String?
  purpose     OtpPurpose @default(LOGIN)

  @@index([phoneNumber])
  @@index([phoneNumber, expiresAt])
  @@index([phoneNumber, purpose])
  @@map("otp_codes")
}

model OtpRequest {
  id          String   @id @default(cuid())
  phoneNumber String
  requestedAt DateTime @default(now())

  @@index([phoneNumber, requestedAt])
  @@map("otp_requests")
}

model Service {
  id               String        @id @default(cuid())
  name             String
  description      String?
  duration         Int
  imageUrl         String?
  capacity         Int           @default(1)
  oneBookingPerDay Boolean       @default(false)
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  bookings         Booking[]
  blockedTimes     BlockedTime[]

  @@map("services")
}

model BlockedTime {
  id        String   @id @default(cuid())
  serviceId String
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  createdAt DateTime @default(now())

  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@index([serviceId, startsAt])
  @@index([serviceId, endsAt])
  @@map("blocked_times")
}

model Booking {
  id             String        @id @default(cuid())
  userId         String
  serviceId      String
  status         BookingStatus @default(CONFIRMED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  endsAt         DateTime
  startsAt       DateTime
  reminderSentAt DateTime?
  service        Service       @relation(fields: [serviceId], references: [id])
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([serviceId])
  @@index([startsAt])
  @@index([endsAt])
  @@index([status])
  @@map("bookings")
}

model Generation {
  id               String         @id @default(cuid())
  userId           String
  originalPhotoUrl String
  resultPhotoUrl   String
  styleChosen      String?
  createdAt        DateTime       @default(now())
  workflowType     AiWorkflowType @default(CUSTOM)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, workflowType])
  @@map("generations")
}

model AiGenerationRequest {
  id          String   @id @default(cuid())
  userId      String
  requestedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, requestedAt])
  @@map("ai_generation_requests")
}

enum UserRole {
  USER
  ADMIN
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum OtpPurpose {
  LOGIN
  REGISTER
}

enum AiWorkflowType {
  CUSTOM
  RECOMMENDATION
}