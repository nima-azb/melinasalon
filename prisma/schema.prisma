generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model User {
  id          String   @id @default(cuid())
  phoneNumber String   @unique
  role        UserRole @default(USER)
  createdAt   DateTime @default(now())

  bookings    Booking[]
  generations Generation[]

  @@map("users")
}

model OtpCode {
  id          String   @id @default(cuid())
  phoneNumber String
  codeHash    String
  expiresAt   DateTime
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([phoneNumber])
  @@index([phoneNumber, expiresAt])
  @@map("otp_codes")
}

model OtpRequest {
  id          String   @id @default(cuid())
  phoneNumber String
  requestedAt DateTime @default(now())

  @@index([phoneNumber, requestedAt])
  @@map("otp_requests")
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  duration    Int
  price       Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  timeSlots TimeSlot[]
  bookings  Booking[]

  @@map("services")
}

model TimeSlot {
  id        String   @id @default(cuid())
  serviceId String
  startsAt  DateTime
  endsAt    DateTime
  capacity  Int      @default(1)
  createdAt DateTime @default(now())

  service  Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([serviceId, startsAt])
  @@index([startsAt])
  @@map("time_slots")
}

model Booking {
  id            String        @id @default(cuid())
  userId        String
  serviceId     String
  timeSlotId    String
  status        BookingStatus @default(PENDING)
  paymentStatus String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  timeSlot TimeSlot @relation(fields: [timeSlotId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([serviceId])
  @@index([timeSlotId])
  @@index([status])
  @@map("bookings")
}

model Generation {
  id               String   @id @default(cuid())
  userId           String
  originalPhotoUrl String
  resultPhotoUrl   String
  styleChosen      String?
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("generations")
}
