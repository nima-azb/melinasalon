generator client {
provider = "prisma-client"
output   = "../src/generated/prisma"
}

datasource db {
provider = "postgresql"
}

model User {
id                   String                @id @default(cuid())
phoneNumber          String                @unique
role                 UserRole              @default(USER)
createdAt            DateTime              @default(now())
bookings             Booking[]
generations          Generation[]
aiGenerationRequests AiGenerationRequest[]

@@map("users")
}

model OtpCode {
id          String   @id @default(cuid())
phoneNumber String
codeHash    String
expiresAt   DateTime
attempts    Int      @default(0)
createdAt   DateTime @default(now())

@@index([phoneNumber])
@@index([phoneNumber, expiresAt])
@@map("otp_codes")
}

model OtpRequest {
id          String   @id @default(cuid())
phoneNumber String
requestedAt DateTime @default(now())

@@index([phoneNumber, requestedAt])
@@map("otp_requests")
}

model Service {
id          String    @id @default(cuid())
name        String
description String?
duration    Int
price       Int?
isActive    Boolean   @default(true)
createdAt   DateTime  @default(now())
bookings    Booking[]

@@map("services")
}

model TimeSlot {
id        String    @id @default(cuid())
startsAt  DateTime  @unique
endsAt    DateTime
capacity  Int       @default(1)
createdAt DateTime  @default(now())
bookings  Booking[]

@@index([startsAt])
@@map("time_slots")
}

model Booking {
id            String        @id @default(cuid())
userId        String
serviceId     String
timeSlotId    String
status        BookingStatus @default(PENDING)
paymentStatus String?
createdAt     DateTime      @default(now())
updatedAt     DateTime      @updatedAt

service  Service  @relation(fields: [serviceId], references: [id])
timeSlot TimeSlot @relation(fields: [timeSlotId], references: [id])
user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

@@index([userId])
@@index([serviceId])
@@index([timeSlotId])
@@index([status])
@@map("bookings")
}

model Generation {
id               String   @id @default(cuid())
userId           String
originalPhotoUrl String
resultPhotoUrl   String
styleChosen      String?
createdAt        DateTime @default(now())

user User @relation(fields: [userId], references: [id], onDelete: Cascade)

@@index([userId, createdAt])
@@map("generations")
}

model AiGenerationRequest {
id          String   @id @default(cuid())
userId      String
requestedAt DateTime @default(now())

user User @relation(fields: [userId], references: [id], onDelete: Cascade)

@@index([userId, requestedAt])
@@map("ai_generation_requests")
}

enum UserRole {
USER
ADMIN
}

enum BookingStatus {
PENDING
CONFIRMED
CANCELLED
COMPLETED
}
